# Leave these blank to run EMS in local demo mode (data stays in this browser).
# Fill them in to use Supabase for sign-in and storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" once the ems-ai Supabase Edge Function is deployed with an
# ANTHROPIC_API_KEY secret. Until then, EMS uses its built-in planner and says so.
VITE_AI_ENABLED=false
